@model LoginViewModel

@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Login";
}

<main class="account-area">

    <section class="account-card">

        <div class="text-center mb-4">

            <div class="account-logo">
                <span class="brand-symbol">❧</span> MemoryLane
            </div>

            <p class="small-heading">YOUR STORIES ARE WAITING</p>

            <h1 class="section-title">Welcome Back</h1>

            <p class="form-intro">
                Sign in and return to your favourite moments.
            </p>

        </div>

        <form asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input asp-for="ReturnUrl" type="hidden" />

            <div class="mb-3">

                <label asp-for="Email" class="form-label"></label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="you@example.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Password" class="form-label"></label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>

            <div class="form-check mb-4">

                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label small">
                </label>

            </div>

            <button type="submit"
                    class="btn btn-terracotta w-100">
                Login to MemoryLane
            </button>

        </form>

        <p class="text-center mt-4 mb-0 small">
            New to MemoryLane?

            <a asp-action="Register"
               class="form-link fw-semibold">
                Create an account
            </a>
        </p>

    </section>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
