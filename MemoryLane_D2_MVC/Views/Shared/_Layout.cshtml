<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - MemoryLane</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head><body>
<nav class="navbar navbar-expand-lg main-nav"><div class="container">
<a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-symbol">❧</span> MemoryLane</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
<a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
@if (User.Identity?.IsAuthenticated == true) {
<a class="nav-link" asp-controller="Memories" asp-action="Index">My Memories</a>
<form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-outline-forest" type="submit">Log Out</button></form>
} else {
<a class="btn btn-outline-forest" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-terracotta" asp-controller="Account" asp-action="Register">Join MemoryLane</a>
}
</div></div></div></nav>
@if (TempData["Message"] != null) { <div class="container mt-3"><div class="alert alert-success">@TempData["Message"]</div></div> }
@RenderBody()
<footer class="footer mt-5"><div class="container d-flex flex-wrap justify-content-between align-items-center gap-2"><a class="brand footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-symbol">❧</span> MemoryLane</a><span class="footer-note">A keepsake for all the moments that matter. © 2026</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
