@model IEnumerable<MemoryLane_D2_MVC.Models.Album>

@{
    ViewData["Title"] = "My Albums";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Albums</h2>
            <p class="text-muted">Organize your memories into albums.</p>
        </div>

        <a asp-action="Create" class="btn btn-warning">
            + Create Album
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var album in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@album.Name</h5>

                            <p class="card-text text-muted">
                                @(string.IsNullOrWhiteSpace(album.Description)
                                                        ? "No description available."
                                                        : album.Description)
                    </p>

                            <form asp-action="Delete" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this album?');">
                                <input type="hidden" name="id" value="@album.Id" />

                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h5>No albums created yet.</h5>
            <p class="text-muted">Create your first album to organize your memories.</p>
            <a asp-action="Create" class="btn btn-warning">
                Create Your First Album
            </a>
        </div>
    }
</div>
