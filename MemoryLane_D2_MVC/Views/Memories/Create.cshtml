@model Memory
@{ ViewData["Title"] = "Add a Memory"; }
<main class="account-area"><section class="account-card" style="max-width:650px"><p class="small-heading">SAVE A LITTLE TREASURE</p><h1 class="section-title">Add a Memory</h1><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Story" class="form-label"></label><textarea asp-for="Story" class="form-control" rows="4"></textarea><span asp-validation-for="Story" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="MemoryDate" class="form-label"></label><input asp-for="MemoryDate" type="date" class="form-control"></div><div class="col-md-6 mb-3"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option>Daily Life</option><option>Travel</option><option>Family</option><option>Friends</option><option>Celebration</option><option>Achievement</option></select></div></div>
<div class="mb-3"><label asp-for="Place" class="form-label"></label><input asp-for="Place" class="form-control"></div><div class="mb-3"><label class="form-label">Photo (JPG, PNG, WEBP; max 5 MB)</label><input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-control"></div>
<button class="btn btn-terracotta">Save Memory</button> <a asp-action="Index" class="btn btn-outline-forest">Cancel</a></form></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
