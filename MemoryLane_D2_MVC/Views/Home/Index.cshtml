@{ ViewData["Title"] = "A Home for Your Stories"; }
<header class="cover-section"><div class="container"><div class="row align-items-center g-5">
<div class="col-lg-6"><p class="small-heading">A PERSONAL ARCHIVE OF LIFE'S LITTLE TREASURES</p>
<h1 class="cover-title">Some moments are too lovely to be <em>forgotten.</em></h1>
<p class="cover-copy">Collect your photographs, write down the stories behind them, and create a place where your favourite memories can live on.</p>
