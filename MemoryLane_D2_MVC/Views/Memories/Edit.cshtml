@model Memory
@{ ViewData["Title"] = "Edit Memory"; }
<main class="account-area"><section class="account-card" style="max-width:650px"><p class="small-heading">UPDATE YOUR STORY</p><h1 class="section-title">Edit Memory</h1><form asp-action="Edit" method="post" enctype="multipart/form-data"><input asp-for="Id" type="hidden"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"></div><div class="mb-3"><label asp-for="Story" class="form-label"></label><textarea asp-for="Story" class="form-control" rows="4"></textarea></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="MemoryDate" class="form-label"></label><input asp-for="MemoryDate" type="date" class="form-control"></div><div class="col-md-6 mb-3"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option>Daily Life</option><option>Travel</option><option>Family</option><option>Friends</option><option>Celebration</option><option>Achievement</option></select></div></div>
<div class="mb-3"><label asp-for="Place" class="form-label"></label><input asp-for="Place" class="form-control"></div><div class="mb-3"><label class="form-label">Replace photo</label><input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-control"></div>
<button class="btn btn-terracotta">Save Changes</button> <a asp-action="Index" class="btn btn-outline-forest">Cancel</a></form></section></main>
